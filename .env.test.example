# Copy to .env.test at the repository root. Create this separate local DB first.
# TEST_DATABASE_URL must point to loopback and a database whose name ends _test.
TEST_DATABASE_URL=postgresql://campus_crew:campus_crew@localhost:5432/campus_crew_test?schema=public
JWT_SECRET=session-27-test-only-secret-never-use-in-production

# Session 28: disposable fixture, only created by test:e2e:prepare in the test DB.
# E2E_EMAIL must use the reserved example.test domain.
E2E_EMAIL=smoke@example.test
E2E_PASSWORD=CampusCrewE2e28!
# Next embeds rewrites at build time; set this before npm run build.
API_BASE_URL=http://127.0.0.1:4000
