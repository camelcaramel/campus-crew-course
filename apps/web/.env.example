# Browser fetch('/api/...') stays same-origin. Do not use NEXT_PUBLIC_.
# Local default; set before dev/build. Vercel requires the Render HTTPS origin.
API_BASE_URL=http://localhost:4000
# API_BASE_URL=https://<render-service>.onrender.com
# Use the origin only (no /api suffix). Rebuild/redeploy after changes.
# Historical local API_ORIGIN remains supported when API_BASE_URL is unset.
