# Copy to apps/api/.env. Existing process environment variables take precedence.
PORT=4000
# Render supplies PORT; do not fix it to 4000 in the dashboard.
# Production environment names (set values in Render, never commit secrets):
# NODE_ENV=production
# DATABASE_URL
# JWT_SECRET
# Prisma CLI reads the repository-root .env or process env, not apps/api/.env.
# Generate your own random value; this placeholder is rejected at startup.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
