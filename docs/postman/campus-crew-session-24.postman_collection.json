{
  "info": {
    "name": "Campus Crew Session 24 - application apply/cancel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local classroom DB only. Main flow creates 2 users and deletes its recruitment. Accounts remain for inspection. Optional final-state folder requires fixtureCookie and approvedRecruitmentId/rejectedRecruitmentId set from isolated DB fixtures; missing fixtures skip those requests. Default port 4024."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4024"
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', String(Date.now()));"
        ]
      }
    }
  ],
