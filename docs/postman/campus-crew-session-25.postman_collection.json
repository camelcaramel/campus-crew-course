        "url": "{{baseUrl}}/api/recruitments/{{recruitmentId}}/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('two safe applicants',()=>{const a=pm.response.json();pm.expect(a).to.have.length(2);a.forEach(row=>{pm.expect(Object.keys(row).sort()).to.eql(['applicant','createdAt','id','message','status']);pm.expect(Object.keys(row.applicant).sort()).to.eql(['email','id','name']);});pm.expect(JSON.stringify(a)).not.to.include('passwordHash');});",
              "pm.test('private response',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
            ]
          }
        }
      ]
    },
