{
  "info": {
    "name": "Campus Crew Session 25 — applicant management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "전용 검증 DB에서만 실행. 세 사용자 cookie, 지원이 없는 recruitmentId, 같은 작성자의 otherRecruitmentId를 환경 변수로 설정. cookie jar를 끄고 요청마다 계정을 지정. 실제 계정/cookie는 이 파일에 저장하지 않습니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "ownerCookie",
      "value": ""
    },
    {
      "key": "applicantCookie",
      "value": ""
    },
    {
      "key": "secondCookie",
      "value": ""
    },
    {
      "key": "recruitmentId",
      "value": ""
    },
    {
      "key": "otherRecruitmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Unauthenticated list",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/recruitments/{{recruitmentId}}/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 401',()=>pm.response.to.have.status(401));"]
          }
        }
      ]
    },
    {
      "name": "Unauthenticated decision",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/recruitments/{{recruitmentId}}/applications/1",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"APPROVED\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 401',()=>pm.response.to.have.status(401));"]
          }
        }
      ]
    },
