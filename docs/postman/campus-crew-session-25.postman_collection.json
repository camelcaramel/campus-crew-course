      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.environment.set('applicationId',pm.response.json().application.id);"
            ]
          }
        }
      ]
    },
