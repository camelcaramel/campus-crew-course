{
  "info": {
    "name": "Campus Crew Session 26 - Search Filter Pagination",
    "description": "GET-only collection. Prepare five title matches (STUDY x3, PROJECT x1, CONTEST x1) with searchPrefix + React, plus one content-only match. searchPrefix must uniquely identify your fixtures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "searchPrefix",
      "value": "S26-demo-"
    }
  ],
  "item": [
    {
      "name": "Defaults",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/recruitments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('items/meta and safe author',()=>{ const b=pm.response.json();pm.expect(b.items).to.be.an('array');pm.expect(b.meta).to.have.all.keys('page','limit','total','totalPages');pm.expect(b.meta.totalPages).to.eql(Math.ceil(b.meta.total/b.meta.limit));b.items.forEach(x=>pm.expect(Object.keys(x.author).sort()).to.eql(['id','name']));});",
              "pm.test('defaults',()=>{const b=pm.response.json();pm.expect(b.meta.page).to.eql(1);pm.expect(b.meta.limit).to.eql(10);});"
            ]
          }
        }
      ]
    },
    {
      "name": "First page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/recruitments?page=1&limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('items/meta and safe author',()=>{ const b=pm.response.json();pm.expect(b.items).to.be.an('array');pm.expect(b.meta).to.have.all.keys('page','limit','total','totalPages');pm.expect(b.meta.totalPages).to.eql(Math.ceil(b.meta.total/b.meta.limit));b.items.forEach(x=>pm.expect(Object.keys(x.author).sort()).to.eql(['id','name']));});",
              "pm.test('two items, newest first',()=>{const b=pm.response.json();pm.expect(b.items).to.have.length(2);pm.expect(Date.parse(b.items[0].createdAt)).to.be.at.least(Date.parse(b.items[1].createdAt));pm.collectionVariables.set('firstIds',JSON.stringify(b.items.map(x=>x.id)));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Second page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/recruitments?page=2&limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('items/meta and safe author',()=>{ const b=pm.response.json();pm.expect(b.items).to.be.an('array');pm.expect(b.meta).to.have.all.keys('page','limit','total','totalPages');pm.expect(b.meta.totalPages).to.eql(Math.ceil(b.meta.total/b.meta.limit));b.items.forEach(x=>pm.expect(Object.keys(x.author).sort()).to.eql(['id','name']));});",
              "pm.test('different items',()=>{const b=pm.response.json();pm.expect(b.meta.page).to.eql(2);pm.expect(b.items).to.have.length(2);const ids=JSON.parse(pm.collectionVariables.get('firstIds'));b.items.forEach(x=>pm.expect(ids).not.to.include(x.id));});"
            ]
          }
        }
      ]
    },
    {
