      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const row = pm.response.json(); pm.collectionVariables.set('recruitmentId', row.id);",
              "pm.test('author from JWT', () => pm.expect(row.authorId).to.eql(Number(pm.collectionVariables.get('ownerId'))));",
              "pm.test('request has no authorId', () => pm.expect(JSON.parse(pm.request.body.raw)).not.to.have.property('authorId'));"
            ]
          }
        }
      ]
    },
