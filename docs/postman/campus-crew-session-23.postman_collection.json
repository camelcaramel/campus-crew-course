    {
      "name": "signup owner",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"작성자\",\n  \"email\": \"session23-owner-{{runId}}@example.com\",\n  \"password\": \"session23-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('ownerId', pm.response.json().id);",
              "pm.test('safe user response', () => pm.expect(pm.response.json()).not.to.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
