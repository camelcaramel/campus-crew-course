{
  "info": {
    "name": "Campus Crew Session 23 — Guard and Owner Authorization",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order on local development only. Creates two test users and deletes its own recruitments; test users remain for inspection. Each request disables the automatic cookie jar and explicitly selects the owner/other cookie. Tokens exist only in local run variables. No JWT secret is needed."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4023"
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 anonymous POST 401",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/recruitments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"session23-postman-{{runId}}\",\n  \"content\": \"23차시 권한 검증용 모집글입니다.\",\n  \"category\": \"STUDY\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 anonymous PATCH 401",
