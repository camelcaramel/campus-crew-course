    {
      "name": "owner me safe identity",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{ownerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('safe identity', () => pm.expect(Object.keys(pm.response.json().user).sort()).to.eql(['email','id','name']));",
              "pm.test('same owner id', () => pm.expect(pm.response.json().user.id).to.eql(Number(pm.collectionVariables.get('ownerId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "create only title content category",
      "protocolProfileBehavior": {
